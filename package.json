{
  "name": "lazaretto-mcp",
  "version": "0.3.1",
  "description": "MCP server for Lazaretto: check a lockfile for known-malicious dependencies (free), scan a skill, tool, or package before an agent installs it, and verify a signed scan attestation another agent shared.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lazaretto-mcp": "index.mjs"
  },
  "main": "index.mjs",
  "scripts": {
    "build": "node --check index.mjs"
  },
  "mcpName": "io.github.jamesdfinance-dev/lazaretto",
  "files": [
    "index.mjs",
    "README.md",
    "server.json"
  ],
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "security",
    "supply-chain",
    "malware",
    "skill",
    "npm",
    "verify",
    "agent",
    "x402",
    "lockfile",
    "pnpm",
    "dependencies",
    "osv",
    "attestation"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesdfinance-dev/lazaretto.git"
  },
  "homepage": "https://lazaretto.dev"
}
